---
// pelican-site/src/components/charts/DemographicChart.astro
// Client-side rendered demographic distribution charts using Observable Plot

interface Props {
  type: 'gender' | 'country' | 'state' | 'ageBins';
  title?: string;
}

const { type, title } = Astro.props;

const defaultTitles: Record<string, string> = {
  gender: 'Gender Distribution',
  country: 'Country Distribution',
  state: 'U.S. State Distribution',
  ageBins: 'Age Distribution',
};

const displayTitle = title || defaultTitles[type] || 'Demographic Distribution';
---

<div
  class="demographic-chart-container"
  data-type={type}
  data-title={displayTitle}
>
  <div class="chart-wrapper rounded-lg border border-[var(--color-border)] p-4 bg-[var(--color-bg)]">
    <h4 class="text-lg font-semibold mb-4 text-[var(--color-text)]">{displayTitle}</h4>
    <div class="chart-target min-h-[200px] flex items-center justify-center">
      <span class="text-[var(--color-text-muted)]">Loading chart...</span>
    </div>
  </div>
</div>

<script>
  import * as Plot from '@observablehq/plot';
  import demographicData from '../../data/demographics.json';

  // Berkeley color palette (matching plot_utils.py)
  const colors = {
    berkeleyBlue: '#003262',
    californiaGold: '#fdb515',
    foundersRock: '#3b7ea1',
    pacific: '#46535e',
    roseGarden: '#ee1f60',
    lawrence: '#00b0da',
    medalist: '#c4820e',
    bayFog: '#ddd5c7',
  };

  // Type definitions
  interface GenderData { gender: string; count: number; }
  interface CountryData { country: string; count: number; }
  interface StateData { state: string; count: number; }
  interface AgeBinData { ageBin: string; count: number; }

  function getData(type: string): (GenderData | CountryData | StateData | AgeBinData)[] {
    switch (type) {
      case 'gender':
        return demographicData.gender as GenderData[];
      case 'country':
        return demographicData.country as CountryData[];
      case 'state':
        return (demographicData.state as StateData[]).slice(0, 15); // Top 15 states
      case 'ageBins':
        return demographicData.ageBins as AgeBinData[];
      default:
        return [];
    }
  }

  function getFieldName(type: string): string {
    switch (type) {
      case 'gender': return 'gender';
      case 'country': return 'country';
      case 'state': return 'state';
      case 'ageBins': return 'ageBin';
      default: return 'name';
    }
  }

  function isDarkMode(): boolean {
    return document.documentElement.classList.contains('dark');
  }

  function getThemeColors() {
    const dark = isDarkMode();
    return {
      background: dark ? '#0f0f0f' : '#ffffff',
      text: dark ? '#f5f5f5' : '#1a1a1a',
      textMuted: dark ? '#9ca3af' : '#6b7280',
      grid: dark ? '#374151' : '#e5e7eb',
    };
  }

  function showError(target: HTMLElement, message: string) {
    const errorDiv = document.createElement('div');
    errorDiv.className = 'chart-error';
    errorDiv.style.cssText = `
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 200px;
      color: var(--color-text-muted, #6b7280);
      text-align: center;
      padding: 1rem;
    `;
    errorDiv.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 0.5rem; opacity: 0.5;">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span style="font-size: 0.875rem;">${message}</span>
    `;
    target.appendChild(errorDiv);
  }

  function renderChart(container: HTMLElement) {
    const type = container.dataset.type || 'gender';
    const target = container.querySelector('.chart-target') as HTMLElement;

    if (!target) return;

    // Clear previous content
    while (target.firstChild) {
      target.removeChild(target.firstChild);
    }

    try {
      const data = getData(type);
      const fieldName = getFieldName(type);

      if (!data || data.length === 0) {
        showError(target, 'No data available for this chart.');
        return;
      }

      const theme = getThemeColors();
      const isHorizontal = type === 'state' || type === 'country';
      const chartHeight = isHorizontal ? Math.max(200, data.length * 25) : 250;

      // Color scale based on type
      const getColor = (type: string): string => {
        switch (type) {
          case 'gender': return colors.roseGarden;
          case 'country': return colors.foundersRock;
          case 'state': return colors.berkeleyBlue;
          case 'ageBins': return colors.medalist;
          default: return colors.pacific;
        }
      };

      let chart;

      if (isHorizontal) {
        // Horizontal bar chart for state/country
        chart = Plot.plot({
          width: 450,
          height: chartHeight,
          marginLeft: type === 'country' ? 200 : 120,
          marginBottom: 40,
          style: {
            background: 'transparent',
            color: theme.text,
            fontSize: '11px',
          },
          x: {
            label: 'Count',
            grid: true,
          },
          y: {
            label: null,
            domain: data.map((d: any) => d[fieldName]),
          },
          marks: [
            Plot.barX(data, {
              x: 'count',
              y: fieldName,
              fill: getColor(type),
              tip: true,
            }),
            Plot.ruleX([0]),
          ],
        });
      } else {
        // Vertical bar chart for gender/age
        chart = Plot.plot({
          width: 450,
          height: chartHeight,
          marginLeft: 50,
          marginBottom: type === 'gender' ? 100 : 60,
          style: {
            background: 'transparent',
            color: theme.text,
            fontSize: '11px',
          },
          x: {
            label: null,
            tickRotate: type === 'gender' ? -45 : 0,
            domain: data.map((d: any) => d[fieldName]),
          },
          y: {
            label: 'Count',
            grid: true,
          },
          marks: [
            Plot.barY(data, {
              x: fieldName,
              y: 'count',
              fill: getColor(type),
              tip: true,
            }),
            Plot.ruleY([0]),
          ],
        });
      }

      target.appendChild(chart);
    } catch (error) {
      console.error('Failed to render demographic chart:', error);
      showError(target, 'Unable to render chart. Please try refreshing the page.');
    }
  }

  function initCharts() {
    const containers = document.querySelectorAll('.demographic-chart-container');
    containers.forEach((container) => {
      renderChart(container as HTMLElement);
    });
  }

  let themeObserver: MutationObserver | null = null;

  function observeThemeChanges() {
    if (themeObserver) {
      themeObserver.disconnect();
    }

    themeObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class') {
          initCharts();
        }
      });
    });

    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }

  function cleanup() {
    if (themeObserver) {
      themeObserver.disconnect();
      themeObserver = null;
    }
  }

  document.addEventListener('astro:before-swap', cleanup);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initCharts();
      observeThemeChanges();
    });
  } else {
    initCharts();
    observeThemeChanges();
  }
</script>

<style>
  .chart-wrapper :global(svg) {
    max-width: 100%;
    height: auto;
  }

  .chart-wrapper :global([aria-label="tip"]) {
    background: var(--color-bg) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: 0.375rem !important;
    padding: 0.5rem !important;
    color: var(--color-text) !important;
    font-size: 0.875rem !important;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1) !important;
  }
</style>
