---
// pelican-site/src/components/layout/Footer.astro
// Footer component with author credits, GitHub link, and institutional attribution

interface Author {
  name: string;
  url?: string;
}

const authors: Author[] = [
  { name: 'Cristopher Benge', url: 'https://github.com/cbenge509' },
  { name: 'Peter Sullivan' },
  { name: 'Zane Metz' },
];

const githubUrl = 'https://github.com/cbenge509/typos_field_experiment';
const currentYear = new Date().getFullYear();
---

<footer class="mt-16 border-t border-[var(--color-border)] bg-[var(--color-surface,var(--color-bg))]">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Authors Section -->
    <div class="mb-8 text-center">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-4">
        Research Team
      </h3>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        {authors.map((author) => (
          author.url ? (
            <a
              href={author.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors font-medium"
            >
              {author.name}
            </a>
          ) : (
            <span class="text-[var(--color-text)] font-medium">
              {author.name}
            </span>
          )
        ))}
      </div>
    </div>

    <!-- Institutional Attribution -->
    <div class="mb-8 text-center">
      <p class="text-[var(--color-text-muted)]">
        <span class="text-[var(--color-berkeley-blue)] dark:text-[var(--color-accent)] font-semibold">
          UC Berkeley School of Information
        </span>
      </p>
      <p class="text-sm text-[var(--color-text-muted)] mt-1">
        Master of Information and Data Science (MIDS) Program
      </p>
      <p class="text-sm text-[var(--color-text-muted)]">
        W241: Experiments and Causal Inference | Spring 2021
      </p>
    </div>

    <!-- GitHub Repository Link -->
    <div class="mb-8 text-center">
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-[var(--color-border)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-text)]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>View Source on GitHub</span>
      </a>
    </div>

    <!-- Divider -->
    <div class="border-t border-[var(--color-border)] pt-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-[var(--color-text-muted)]">
        <!-- Copyright -->
        <p>
          &copy; {currentYear} Cristopher Benge, Peter Sullivan, Zane Metz
        </p>

        <!-- License -->
        <p class="flex items-center gap-1">
          <span>Licensed under</span>
          <a
            href="https://opensource.org/licenses/MIT"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--color-accent)] transition-colors underline"
          >
            MIT License
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Add surface color for footer if not defined */
  footer {
    --color-surface: color-mix(in srgb, var(--color-bg), var(--color-border) 5%);
  }

  .dark footer {
    --color-surface: color-mix(in srgb, var(--color-bg), var(--color-border) 10%);
  }
</style>
