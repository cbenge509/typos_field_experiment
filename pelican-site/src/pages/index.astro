---
// pelican-site/src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/layout/ThemeToggle.astro';
import TableOfContents from '../components/layout/TableOfContents.astro';
import ParticipantCount from '../components/charts/ParticipantCount.astro';
import DemographicChart from '../components/charts/DemographicChart.astro';
import DivergencePlot from '../components/charts/DivergencePlot.astro';
import LikertVariance from '../components/charts/LikertVariance.astro';
import WpmByGroup from '../components/charts/WpmByGroup.astro';

const tocItems = [
  { id: 'abstract', title: 'Abstract' },
  { id: 'introduction', title: 'Introduction' },
  { id: 'methods', title: 'Methods' },
  { id: 'results', title: 'Results' },
  { id: 'discussion', title: 'Discussion' },
  { id: 'conclusion', title: 'Conclusion' },
];
---

<BaseLayout title="Do Grammatical Errors Affect Perceived Intelligence?">
  <header class="sticky top-0 z-50 bg-[var(--color-bg)]/80 backdrop-blur-sm border-b border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <h1 class="text-lg font-semibold text-[var(--color-accent)]">Typos Study</h1>
      <ThemeToggle />
    </div>
  </header>

  <div class="flex">
    <TableOfContents items={tocItems} />

    <main class="flex-1 lg:ml-60 max-w-4xl mx-auto px-4 py-8">
      <article>
        <h2 class="text-3xl font-bold mb-8">
          Do Grammatical Errors in Social Media Posts Affect the Perception of Authors' Intelligence?
        </h2>

        <section id="abstract" class="mb-12">
          <h3 class="text-2xl font-semibold mb-4 text-[var(--color-accent)]">Abstract</h3>
          <p class="text-[var(--color-text-muted)]">
            Placeholder content for abstract section.
          </p>
        </section>

        <section id="introduction" class="mb-12">
          <h3 class="text-2xl font-semibold mb-4 text-[var(--color-accent)]">Introduction</h3>
          <p class="text-[var(--color-text-muted)]">
            Placeholder content for introduction section.
          </p>
        </section>

        <section id="methods" class="mb-12">
          <h3 class="text-2xl font-semibold mb-4 text-[var(--color-accent)]">Methods</h3>
          <p class="text-[var(--color-text-muted)] mb-6">
            Placeholder content for methods section.
          </p>

          <h4 class="text-xl font-semibold mb-4 text-[var(--color-text)]">Pilot Study Participants</h4>
          <p class="text-[var(--color-text-muted)] mb-4">
            The pilot study included 31 participants randomly assigned to three treatment groups.
          </p>
          <ParticipantCount dataset="pilot" title="Pilot Study: Participants by Treatment Group" />

          <h4 class="text-xl font-semibold mt-8 mb-4 text-[var(--color-text)]">Live Study Participants</h4>
          <p class="text-[var(--color-text-muted)] mb-4">
            The live study recruited participants from Amazon Mechanical Turk and UC Berkeley XLab.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <ParticipantCount dataset="amazon" title="Amazon MTurk Participants" />
            <ParticipantCount dataset="xlab" title="XLab Participants" />
          </div>

          <h4 class="text-xl font-semibold mt-8 mb-4 text-[var(--color-text)]">Participant Demographics</h4>
          <p class="text-[var(--color-text-muted)] mb-4">
            Our study drew participants primarily from the United States, with a diverse age and gender distribution.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <DemographicChart type="gender" />
            <DemographicChart type="ageBins" />
          </div>
          <div class="mb-6">
            <DemographicChart type="state" title="U.S. State Distribution (Top 15)" />
          </div>

          <h4 class="text-xl font-semibold mt-8 mb-4 text-[var(--color-text)]">Response Quality</h4>
          <p class="text-[var(--color-text-muted)] mb-4">
            We analyzed response quality by examining reading speed (words per minute) and Likert scale response variance to identify potential low-effort respondents.
          </p>
          <div class="space-y-6">
            <WpmByGroup maxWpm={800} />
            <LikertVariance />
          </div>
        </section>

        <section id="results" class="mb-12">
          <h3 class="text-2xl font-semibold mb-4 text-[var(--color-accent)]">Results</h3>
          <p class="text-[var(--color-text-muted)] mb-6">
            The divergence plots below show the distribution of Likert scale responses by treatment group. Bars extending left represent disagreement (ranks 1-3), while bars extending right represent agreement (ranks 5-7). The center represents neutral responses (rank 4).
          </p>

          <div class="space-y-6">
            <DivergencePlot question="intelligence" title="Perceived Intelligence by Treatment Group" />
            <DivergencePlot question="effective" title="Perceived Effectiveness by Treatment Group" />
            <DivergencePlot question="writing" title="Perceived Writing Quality by Treatment Group" />
          </div>
        </section>

        <section id="discussion" class="mb-12">
          <h3 class="text-2xl font-semibold mb-4 text-[var(--color-accent)]">Discussion</h3>
          <p class="text-[var(--color-text-muted)]">
            Placeholder content for discussion section.
          </p>
        </section>

        <section id="conclusion" class="mb-12">
          <h3 class="text-2xl font-semibold mb-4 text-[var(--color-accent)]">Conclusion</h3>
          <p class="text-[var(--color-text-muted)]">
            Placeholder content for conclusion section.
          </p>
        </section>
      </article>
    </main>
  </div>
</BaseLayout>
