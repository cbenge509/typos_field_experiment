---
// pelican-site/src/components/content/Section.astro
// Reusable section component for academic paper structure

interface Props {
  id: string;
  title: string;
  level?: 2 | 3 | 4;
  className?: string;
}

const { id, title, level = 2, className = '' } = Astro.props;

const HeadingTag = `h${level}` as 'h2' | 'h3' | 'h4';

const headingStyles: Record<number, string> = {
  2: 'text-2xl font-bold text-[var(--color-accent)] border-b-2 border-[var(--color-accent)] pb-2',
  3: 'text-xl font-semibold text-[var(--color-text)]',
  4: 'text-lg font-medium text-[var(--color-text)]',
};
---

<section id={id} class:list={['mb-12 scroll-mt-20', className]}>
  <HeadingTag class:list={['mb-6', headingStyles[level]]}>
    {title}
  </HeadingTag>
  <div class="prose prose-lg dark:prose-invert max-w-none">
    <slot />
  </div>
</section>

<style>
  /* Prose styling for content */
  .prose :global(p) {
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose :global(em) {
    color: var(--color-accent);
    font-style: italic;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    opacity: 0.8;
  }

  .prose :global(ul),
  .prose :global(ol) {
    color: var(--color-text-muted);
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .prose :global(code) {
    background: var(--color-border);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    color: var(--color-text);
  }

  .prose :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: 0.875rem;
  }

  .prose :global(sup) {
    font-size: 0.75em;
    vertical-align: super;
  }

  .prose :global(sub) {
    font-size: 0.75em;
    vertical-align: sub;
  }
</style>
